<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tempHomeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lenslink_cream"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/lenslink_charcoal"
        android:textSize="32sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="@string/temp_home_notice"
        android:textColor="@color/lenslink_text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvSignedInAs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/temp_home_loading"
        android:textColor="@color/lenslink_charcoal"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnProfile"
        style="@style/LensLink.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:text="@string/button_view_profile" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/LensLink.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="@string/button_log_out" />
</LinearLayout>